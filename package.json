{
  "name": "jaffloop",
  "productName": "Jaffloop",
  "version": "0.5.0",
  "description": "Menu bar app for engineering managers: track what you owe, what's owed to you, and what you told people. Local-first, with an MCP server for Claude.",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "author": "Jaffloop",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "mcp": "node dist/mcp/server.cjs",
    "screenshots": "JAFFLOOP_SCREENSHOTS=docs/screenshots vitest run --config vitest.e2e.config.ts test/e2e/screenshots.test.ts"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@preact/signals": "^2.11.3",
    "@types/node": "^22.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.56.1",
    "preact": "^10.27.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
